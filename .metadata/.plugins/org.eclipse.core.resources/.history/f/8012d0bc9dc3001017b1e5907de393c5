uint8_t execute_flash_erase(uint8_t sector_number , uint8_t number_of_sector)
{

  //we have totally 8 sectors in STM32F446RE mcu .. sector[0 to 7]
  //number_of_sector has to be in the range of 0 to 7
  // if sector_number = 0xff , that means mass erase !
  //Code needs to modified if your MCU supports more flash sectors
  FLASH_EraseInitTypeDef flashErase_handle;
  uint32_t sectorError;
  HAL_StatusTypeDef status;


  if( number_of_sector > 8 )
    return INVALID_SECTOR;

  if( (sector_number == 0xff ) || (sector_number <= 7) ) {
    if(sector_number == (uint8_t) 0xff) {
    flashErase_handle.TypeErase = FLASH_TYPEERASE_MASSERASE;

    } else {
      /*Here we are just calculating how many sectors needs to erased */
      uint8_t remanining_sector = 8 - sector_number;
      if( number_of_sector > remanining_sector) {

        number_of_sector = remanining_sector;
      }
      flashErase_handle.TypeErase = FLASH_TYPEERASE_SECTORS;
      flashErase_handle.Sector = sector_number; // this is the initial sector
      flashErase_handle.NbSectors = number_of_sector;
    }
    flashErase_handle.Banks = FLASH_BANK_1;

    /*Get access to touch the flash registers */
    HAL_FLASH_Unlock();
    flashErase_handle.VoltageRange = FLASH_VOLTAGE_RANGE_3;  // our mcu will work on this voltage range
    status = (uint8_t) HAL_FLASHEx_Erase(&flashErase_handle, &sectorError);
    HAL_FLASH_Lock();

    return status;
  }

  return INVALID_SECTOR;
}

uint8_t program_memory(uint8_t *pBuffer, uint32_t base_mem_addr, uint8_t payload_length)
{
	uint8_t status = HAL_OK;
	HAL_FLASH_Unlock();

	for(uint8_t i = 0; i <= payload_length; i++)
	{
		status = HAL_FLASH_Program(FLASH_TYPEPROGRAM_BYTE, base_mem_addr + i, pBuffer[i]);
	}

	HAL_FLASH_Lock();
	return status;
}

uint8_t configure_protection(uint8_t protection, uint8_t sector_detail, uint8_t disable)
{

	uint8_t status = HAL_OK;
	uint32_t *pOPTCR = (uint32_t*) 0x40023C14;

	if(disable == 0)
	{
		HAL_FLASH_OB_Unlock();
		while(__HAL_FLASH_GET_FLAG(FLASH_FLAG_BSY) != RESET);
		if(protection == 1)
		{
			*pOPTCR &= ~(1 << 31);
			*pOPTCR &= ((protection << 16) | 0xFF00FFFF);
		}
		else
		{
			*pOPTCR |= (1 << 31);
			*pOPTCR &= ((protection << 16) | 0xFF00FFFF);
		}
		// set the option start bit(otpstart)
		*pOPTCR |= (1 << 1);
		while(__HAL_FLASH_GET_FLAG(FLASH_FLAG_BSY) != RESET);
		status = HAL_FLASH_OB_Lock();
	}
	else
	{
		HAL_FLASH_OB_Unlock();
		while(__HAL_FLASH_GET_FLAG(FLASH_FLAG_BSY) != RESET);
		*pOPTCR &= ~(1 << 31);
		*pOPTCR |= (0xFF << 16) ;
		// set the option start bit(otpstart)
		*pOPTCR |= (1 << 1);
		while(__HAL_FLASH_GET_FLAG(FLASH_FLAG_BSY) != RESET);
		status = HAL_FLASH_OB_Lock();

	}
	return status;
}
