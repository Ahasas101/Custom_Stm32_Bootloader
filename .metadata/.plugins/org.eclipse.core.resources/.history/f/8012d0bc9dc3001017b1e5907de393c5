void bootloader_handle_getver_cmd(uint8_t *bl_rx_buffer)
{
	uint8_t bl_version;
	//1. Verify the checksum(CRC)
	printmsg("BL_DEBUG_MSG:bootloader handler getver cmd\n");
	 // 1) verify the checksum
	  printmsg("BL_DEBUG_MSG:bootloader_handle_getver_cmd\n");

	  //Total length of the command packet
	  uint32_t command_packet_len = bl_rx_buffer[0]+1 ;

	  //extract the CRC32 sent by the Host
	  uint32_t host_crc = *((uint32_t * ) (bl_rx_buffer+command_packet_len - 4) ) ;

	if(! bootloader_verify_crc(&bl_rx_buffer[0], 2, host_crc))
	{
		printmsg("BL_DEBUG_MSG:checksum success !!\n");
		//checksum is correct..
		bootloader_send_ack(bl_rx_buffer[0],1);
		bl_version = get_bootloader_version();
		printmsg("BL_DEBUG_MSG:BL_VER: %d %#\n", bl_version, bl_version);
		bootloader_uart_write_data(&bl_version, 1);
	}else
	{
		printmsg("BL_DEBUS_MSG:checksum fail !!\n");
		//checksum is wrong send nack
		bootloader_send_nack();
	}


}
