void bootloader_handle_go_cmd(uint8_t *pBuffer)
{
	uint32_t go_addr = 0;
	uint8_t addr_valid = ADDR_VALID;
	uint8_t addr_invalid = ADDR_INVALID;
	//1. Verify the checksum(CRC)
		printmsg("BL_DEBUG_MSG:bootloader handler go_cmd cmd\n");
			//Total length of the command packet
		  uint32_t command_packet_len = bl_rx_buffer[0]+1 ;

		  //extract the CRC32 sent by the Host
		  uint32_t host_crc = *((uint32_t * ) (bl_rx_buffer+command_packet_len - 4) ) ;

		if(! bootloader_verify_crc(&pBuffer[0], command_packet_len - 4, host_crc))
		{
			printmsg("BL_DEBUG_MSG:checksum success !!\n");
			//checksum is correct..

			bootloader_send_ack(bl_rx_buffer[0],1);

			//etract the go address
			go_addr = *((uint32_t*)&pBuffer[2]);
			if(verify_addr(go_addr) == ADDR_VALID)
			{
				// tell host that address is find
				bootloader_uart_write_data(&addr_valid, 1);

				go_addr += 1; // for T bit
				void(*lets_jump)(void) = (void*)go_addr;

				printmsg("BL_DEBUG_MSG: jumping to the address\n");
				lets_jump();
			}
			else
			{
				printmsg("BL_DEBUS_MSG: invalid address\n");
				bootloader_uart_write_data(&addr_invalid, 1);
			}

		}else
		{
			printmsg("BL_DEBUS_MSG:checksum fail !!\n");
			//checksum is wrong send nack
			bootloader_send_nack();
		}

}
