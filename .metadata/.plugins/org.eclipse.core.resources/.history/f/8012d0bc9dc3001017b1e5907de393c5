}

uint8_t get_flash_rdp_level(void)
{
	volatile uint32_t *pob_addr = (uint32_t*)0x1FFFC000;
	uint8_t rdp_status = (uint8_t)(*(pob_addr) >> 8);
	return rdp_status;
}
uint8_t verify_addr(uint32_t addr)
{
	if(addr >= SRAM1_BASE && addr <= 0x20020000)
	{
		return ADDR_VALID;
	}
//	if(addr >= SRAM2_BASE && addr <= SRAM2_END)
//	{
//		return ADDR_VALID;
//	}
	if(addr >= FLASH_BASE && addr <= FLASH_END)
		{
			return ADDR_VALID;
		}
